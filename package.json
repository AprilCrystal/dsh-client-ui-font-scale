{
  "name": "dsh-client-ui-font-scale",
  "version": "0.1.0",
  "type": "module",
  "description": "Conversation font-size controls for the DeepSeek Harness Web UI: a composer-row stepper, keyboard shortcuts, and Ctrl+wheel zoom, all writing through the theme service's setFontSize",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "validate": "node scripts/validate-plugin.mjs ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "client-plugin",
    "font-size",
    "zoom",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AprilCrystal/dsh-client-ui-font-scale.git"
  },
  "homepage": "https://github.com/AprilCrystal/dsh-client-ui-font-scale#readme",
  "bugs": {
    "url": "https://github.com/AprilCrystal/dsh-client-ui-font-scale/issues"
  },
  "author": "AprilCrystal",
  "license": "MIT"
}
